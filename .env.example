# Copie para .env (ou rode `npm run setup`, que cria o .env com um SESSION_SECRET aleatório).

# Banco PostgreSQL. No Supabase use o "Session pooler" (porta 5432) e um schema próprio:
#   produção:        ...?schema=nutra
#   desenvolvimento: ...?schema=nutra_dev
# Senhas com caracteres especiais precisam ser codificadas (@ vira %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?schema=nutra_dev"

# Segredo usado para assinar a sessão (mínimo 32 caracteres, aleatório).
SESSION_SECRET="troque-por-um-valor-aleatorio-com-no-minimo-32-caracteres"

# Opcional: número máximo de conexões do app com o banco (padrão 5).
# DATABASE_POOL_MAX="5"

# Opcional: força o cookie de sessão como "Secure" (padrão: só em produção).
# COOKIE_SECURE="true"
